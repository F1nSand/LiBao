# ============ 通用 ============
APP_ENV=dev
DEBUG=true
# SQLAlchemy SQL 日志（默认关；DEBUG=true 不会自动刷 SQL，需调试时改 true）
SQL_ECHO=false
BASE_URL=/api/v1
LOG_LEVEL=INFO

# ============ 认证 ============
JWT_SECRET=dev-only-change-me-in-prod-0123456789abcdef
JWT_EXPIRE_MINUTES=720

# ============ 数据存储 ============
# SQLAlchemy（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
# LangGraph checkpointer（psycopg 驱动，同库，剥掉 +asyncpg 前缀）
CHECKPOINT_DSN=postgresql://agent:agent@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0

# ============ LLM（LiteLLM）============
# 提供方: deepseek / ollama / qwen / kimi / gpt ... 由 LiteLLM 前缀解析
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek/deepseek-chat
# DeepSeek API key（https://platform.deepseek.com）
LLM_API_KEY=
# 自定义 OpenAI 兼容端点时填写（如企业代理）
LLM_BASE_URL=

# ============ M3 Embedding（SiliconFlow，OpenAI 兼容）============
# 知识库向量化；维度 1024 与迁移 0004 的 vector(1024) 一致
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# SiliconFlow API key（https://cloud.siliconflow.cn）
EMBEDDING_API_KEY=

# ============ M3 附件（本地磁盘 MVP）============
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ============ 跨域 ============
CORS_ORIGINS=["http://localhost:5173"]

# ============ 时区（time_now 工具）============
TZ=Asia/Shanghai

# ============ 工具结果摘要 ============
# dict/list 型工具输出 json 化后回传 LLM 的字符上限（str 输出不受此限，原样透传）
TOOL_RESULT_MAX_CHARS=8000

# ============ M8 热点收集（GitHub）============
# GitHub API token（https://github.com/settings/tokens，只读权限即可；缺省匿名 60 req/h 配额受限）
GITHUB_TOKEN=
# 访问 GitHub 的 HTTP 代理（国内直连被墙时填，如 Clash http://127.0.0.1:7890 / V2Ray http://127.0.0.1:10809）
GITHUB_PROXY=
# GitHub 镜像前缀（直连失败时匿名兜底；默认 gh-proxy.com，置空禁用镜像）
GITHUB_MIRROR=https://gh-proxy.com/
