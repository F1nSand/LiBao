# ============ 通用 ============
APP_ENV=dev
DEBUG=true
BASE_URL=/api/v1
LOG_LEVEL=INFO

# ============ LLM（LiteLLM）============
# 提供方: deepseek / ollama / qwen / kimi / gpt ... 由 LiteLLM 前缀解析
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek/deepseek-chat
# DeepSeek API key（https://platform.deepseek.com）
LLM_API_KEY=
# 自定义 OpenAI 兼容端点时填写（如企业代理 / 本地 Ollama http://localhost:11434/v1）
LLM_BASE_URL=

# ============ M3 Embedding（SiliconFlow，OpenAI 兼容）============
# 知识库向量化；维度 1024 与 LanceDB schema 一致（换模型 = 重建向量库）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# SiliconFlow API key（https://cloud.siliconflow.cn）
EMBEDDING_API_KEY=

# ============ M3 附件（本地磁盘）============
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ============ 时区（time_now 工具）============
TZ=Asia/Shanghai

# ============ 工具结果摘要 ============
# dict/list 型工具输出 json 化后回传 LLM 的字符上限（str 输出不受此限，原样透传）
TOOL_RESULT_MAX_CHARS=8000

# ============ M8 热点收集（GitHub）============
# GitHub API token（https://github.com/settings/tokens，只读权限即可；缺省匿名 60 req/h 配额受限）
GITHUB_TOKEN=
# 访问 GitHub 的 HTTP 代理（国内直连被墙时填，如 Clash http://127.0.0.1:7890 / V2Ray http://127.0.0.1:10809）
GITHUB_PROXY=
# GitHub 镜像前缀（直连失败时匿名兜底；默认 gh-proxy.com，置空禁用镜像）
GITHUB_MIRROR=https://gh-proxy.com/

# ============ Bash 语义审查（独立 curl LLM 通道，2026-08-25）============
# bash 命令执行前经 bash+curl 直连此 LLM 做语义审查/注入检测/输出校验（与应用内主 LLM 通道解耦）。
# ⚠ 待审查的命令字符串会 POST 到此 endpoint（外发到云端）；key 只进 .env。
BASH_REVIEW_ENABLED=true
# 审查 LLM 的 OpenAI 兼容 endpoint（必配才启用 curl 审查；不配 → 降级规则快速通道）
BASH_REVIEW_ENDPOINT=
# 独立 key（可复用主 LLM 的供应商，建议独立 key 便于配额/审计）
BASH_REVIEW_API_KEY=
# 模型名（如 deepseek-chat / Qwen/Qwen3-... 按 endpoint 供应商）
BASH_REVIEW_MODEL=
# curl 超时（秒）
BASH_REVIEW_TIMEOUT=15
BASH_REVIEW_CONNECT_TIMEOUT=5
# 显式 HTTP 代理（云端 endpoint 国内直连被墙时填；curl 不读 Windows 系统代理）
BASH_REVIEW_PROXY=
# 熔断：审查通道连续失败达阈值 → 冷却期后试水
BASH_REVIEW_BREAKER_THRESHOLD=3
BASH_REVIEW_BREAKER_COOLDOWN_S=60
# 审查不可用时允许放行的最高风险档（low/medium/high；默认 medium = 高风险命令 fail-close 拦截）
BASH_REVIEW_FAILOPEN_MAX_GRADE=medium
