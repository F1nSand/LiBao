# ============ 通用 ============
APP_ENV=dev
DEBUG=true
BASE_URL=/api/v1
LOG_LEVEL=INFO

# ============ 认证 ============
JWT_SECRET=dev-only-change-me-in-prod-0123456789abcdef
JWT_EXPIRE_MINUTES=720

# ============ 数据存储 ============
# SQLAlchemy（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
# LangGraph checkpointer（psycopg 驱动，同库，剥掉 +asyncpg 前缀）
CHECKPOINT_DSN=postgresql://agent:agent@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0

# ============ LLM（LiteLLM）============
# 提供方: deepseek / ollama / qwen / kimi / gpt ... 由 LiteLLM 前缀解析
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek/deepseek-chat
# DeepSeek API key（https://platform.deepseek.com）
LLM_API_KEY=
# 自定义 OpenAI 兼容端点时填写（如企业代理）
LLM_BASE_URL=
LLM_EMBED_MODEL=text-embedding-3-small

# ============ 跨域 ============
CORS_ORIGINS=["http://localhost:5173"]

# ============ 时区（time_now 工具）============
TZ=Asia/Shanghai
